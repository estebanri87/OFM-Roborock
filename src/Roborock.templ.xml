          <Dynamic>
            <ChannelIndependentBlock>
              <!-- Eine eigene Tabelle je Kanal auf der Seite "Kanalauswahl". -->
              <ParameterBlock Id="%AID%_PB-nnn" Name="Settings">
                <ParameterBlock Id="%AID%_PB-nnn" Inline="true" Layout="Grid">
                  <Rows>
                    <Row Id="%AID%_PB-nnn_R-1" />
                  </Rows>
                  <Columns>
                    <Column Id="%AID%_PB-nnn_C-1" Width="20%" />
                    <Column Id="%AID%_PB-nnn_C-2" Width="30%" />
                    <Column Id="%AID%_PB-nnn_C-3" Width="50%" />
                  </Columns>
                  <ParameterSeparator Id="%AID%_PS-nnn" Cell="1,1" Text="Kanal %C%" />
                  <!-- Haupttyp (mit Deaktiviert): nur hier wird ein Kanal aktiviert/deaktiviert -->
                  <ParameterRefRef RefId="%AID%_UP-%TT%%CC%010_R-%TT%%CC%01001" Cell="1,2" HelpContext="ROB-Kanaltyp" />
                  <!-- Beschreibung bleibt auch bei Deaktiviert sichtbar -->
                  <ParameterRefRef RefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" Cell="1,3" HelpContext="BASE-ChannelName" />
                </ParameterBlock>
              </ParameterBlock>

              <!-- Kanal-Tab, nur für aktivierte Kanäle (Haupttyp > 0). -->
              <ParameterBlock Id="%AID%_PB-nnn" Name="Channel">
                <choose ParamRefId="%AID%_UP-%TT%%CC%010_R-%TT%%CC%01001">
                  <when test=">0">
                    <ParameterBlock Id="%AID%_PB-nnn" Name="Channel%C%Page" Text="Kanal %C%: {{0: ...}}" TextParameterRefId="%AID%_P-%TT%%CC%998_R-%TT%%CC%99801" Icon="remote" ShowInComObjectTree="true" HelpContext="ROB-Kanaltyp">
                      <ParameterSeparator Id="%AID%_PS-nnn" Text="Kanaldefinition" UIHint="Headline" />
                      <ParameterRefRef IndentLevel="1" RefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" HelpContext="BASE-ChannelName" />
                      <ParameterRefRef IndentLevel="1" RefId="%AID%_P-%TT%%CC%011_R-%TT%%CC%01101" HelpContext="ROB-Kanaltyp" />
                      <ParameterRefRef IndentLevel="1" RefId="%AID%_UP-%TT%%CC%012_R-%TT%%CC%01201" HelpContext="BASE-ChannelSuspended" />

                      <choose ParamRefId="%AID%_UP-%TT%%CC%010_R-%TT%%CC%01001">
                        <!-- 1 = Roborock (miIO lokal) -->
                        <when test="=1">
                          <ParameterSeparator Id="%AID%_PS-nnn" Text="Verbindung" UIHint="Headline" />
                          <ParameterRefRef IndentLevel="1" RefId="%AID%_UP-%TT%%CC%001_R-%TT%%CC%00101" HelpContext="ROB-Verbindung" />
                          <ParameterRefRef IndentLevel="1" RefId="%AID%_UP-%TT%%CC%002_R-%TT%%CC%00201" HelpContext="ROB-Token" />

                          <ParameterSeparator Id="%AID%_PS-nnn" Text="Abfrage" UIHint="Headline" />
                          <ParameterRefRef IndentLevel="1" RefId="%AID%_UP-%TT%%CC%003_R-%TT%%CC%00301" HelpContext="ROB-Abfrage" />
                          <ParameterRefRef IndentLevel="1" RefId="%AID%_UP-%TT%%CC%004_R-%TT%%CC%00401" HelpContext="ROB-Verschleiss" />

