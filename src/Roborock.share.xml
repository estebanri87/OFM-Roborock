<?xml version="1.0" encoding="utf-8"?>
<?xml-model href="../../Organization/knxprod-support/knx_project_14/knx-editor.xsd" type="application/xml" schematypens="http://www.w3.org/2001/XMLSchema"?>
<KNX xmlns:op="http://github.com/OpenKNX/OpenKNXproducer" xmlns="http://knx.org/xml/project/14" CreatedBy="KNX MT" ToolVersion="5.1.255.16695">
  <ManufacturerData>
    <Manufacturer>
      <ApplicationPrograms>
        <ApplicationProgram>
          <Static>
            <ParameterTypes>
              <!-- Haupttyp (Kanalauswahl-Tabelle, mit Deaktiviert) -->
              <ParameterType Id="%AID%_PT-ROBChannelType" Name="ROBChannelType">
                <TypeRestriction Base="Value" SizeInBit="8" UIHint="DropDown">
                  <Enumeration Text="Deaktiviert" Value="0" Id="%AID%_PT-ROBChannelType_EN-0" />
                  <Enumeration Text="Roborock (miIO lokal)" Value="1" Id="%AID%_PT-ROBChannelType_EN-1" />
                </TypeRestriction>
              </ParameterType>
              <!-- TypeSelect (Kanal-Tab, ohne Deaktiviert) -->
              <ParameterType Id="%AID%_PT-ROBTypeSelect" Name="ROBTypeSelect">
                <TypeRestriction Base="Value" SizeInBit="8" UIHint="DropDown">
                  <Enumeration Text="Roborock (miIO lokal)" Value="1" Id="%AID%_PT-ROBTypeSelect_EN-1" />
                </TypeRestriction>
              </ParameterType>
              <!-- Nur IPv4-Literale: eine Namensauflösung würde die Firmware blockieren. -->
              <ParameterType Id="%AID%_PT-ROBIp" Name="ROBIp">
                <TypeText SizeInBit="128" Pattern="^$|^([0-9]{1,3}\.){3}[0-9]{1,3}$" />
              </ParameterType>
              <!-- miIO-Token: 32 Hex-Zeichen (+ Endnull) -->
              <ParameterType Id="%AID%_PT-ROBToken" Name="ROBToken">
                <TypeText SizeInBit="264" Pattern="^$|^[0-9A-Fa-f]{32}$" />
              </ParameterType>
              <ParameterType Id="%AID%_PT-ROBPoll" Name="ROBPoll">
                <TypeNumber SizeInBit="16" Type="unsignedInt" minInclusive="0" maxInclusive="3600" />
              </ParameterType>
              <ParameterType Id="%AID%_PT-ROBMinutes" Name="ROBMinutes">
                <TypeNumber SizeInBit="8" Type="unsignedInt" minInclusive="0" maxInclusive="240" />
              </ParameterType>
            </ParameterTypes>

            <Parameters>
              <!-- Modulweite Einstellungen. Offsets sind modulrelativ. -->
              <!-- Offset 0, Bit 0: früher "Modul aktiv", jetzt Modulliste in OpenKNX/Common. Frei lassen. -->
              <Union SizeInBit="8">
                <Memory CodeSegment="%MID%" Offset="0" BitOffset="0" />
                <Parameter Id="%AID%_UP-%TT%00010" Name="ROBUseDiag" ParameterType="%AID%_PT-CheckBox" Offset="0" BitOffset="1" Text="Diagnose-Meldungstext" Value="0" />
              </Union>
              <!-- Offsets 1..7 bleiben frei (Reserve für spätere Parameter). -->
            </Parameters>

            <ParameterRefs>
              <ParameterRef Id="%AID%_UP-%TT%00010_R-%TT%0001001" RefId="%AID%_UP-%TT%00010" />
            </ParameterRefs>

            <ComObjectTable>
              <ComObject Id="%AID%_O-%TT%00000" Number="0" Name="ROBDiag" Text="Diagnose" FunctionText="Roborock: Ausgang, Meldungstext" ObjectSize="14 Bytes" DatapointType="DPST-16-1" ReadFlag="Enabled" WriteFlag="Disabled" CommunicationFlag="Enabled" TransmitFlag="Enabled" UpdateFlag="Disabled" ReadOnInitFlag="Disabled" />
            </ComObjectTable>

            <ComObjectRefs>
              <ComObjectRef Id="%AID%_O-%TT%00000_R-%TT%0000001" RefId="%AID%_O-%TT%00000" />
            </ComObjectRefs>
          </Static>

          <Dynamic>
            <Channel Name="MainChannel%TT%" Text="Roborock" Number="%PREFIX%" Id="%AID%_CH-%TT%" Icon="remote">
              <ParameterBlock Id="%AID%_PB-nnn" Name="ROBSettings" Text="Allgemein" Icon="cog-outline" HelpContext="ROB-Allgemein">
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Roborock (miIO lokal)" UIHint="Headline" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Version: %ModuleVersion%" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Saugroboter mit der klassischen Roborock-Schnittstelle (z.B. S5) werden direkt im lokalen Netz angesprochen, ohne Cloud. Je Roboter wird ein Kanal mit IP-Adresse und Token angelegt. Nur auf ESP32-Geräten verfügbar." UIHint="Information" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Objekte" UIHint="Headline" />
                <ParameterRefRef IndentLevel="1" RefId="%AID%_UP-%TT%00010_R-%TT%0001001" HelpContext="ROB-Diagnose" />
                <choose ParamRefId="%AID%_UP-%TT%00010_R-%TT%0001001">
                  <when test="=1">
                    <ComObjectRefRef RefId="%AID%_O-%TT%00000_R-%TT%0000001" />
                  </when>
                </choose>
              </ParameterBlock>

              <!-- Kanalauswahl: je Kanal eine einzeilige Tabelle (OpenKNX-Standard, Typ-Variante) -->
              <ParameterBlock Id="%AID%_PB-nnn" Name="ROBChannelSelect" Text="Kanalauswahl" Icon="format-list-bulleted-type" HelpContext="BASE-ChannelSelect">
                <ParameterBlock Id="%AID%_PB-nnn" Inline="true" Layout="Grid">
                  <Rows>
                    <Row Id="%AID%_PB-nnn_R-1" />
                  </Rows>
                  <Columns>
                    <Column Id="%AID%_PB-nnn_C-1" Width="20%" />
                    <Column Id="%AID%_PB-nnn_C-2" Width="30%" />
                    <Column Id="%AID%_PB-nnn_C-3" Width="50%" />
                  </Columns>
                  <ParameterSeparator Id="%AID%_PS-nnn" Cell="1,1" UIHint="Headline" Text="Kanal" />
                  <ParameterSeparator Id="%AID%_PS-nnn" Cell="1,2" UIHint="Headline" Text="Kanaltyp" />
                  <ParameterSeparator Id="%AID%_PS-nnn" Cell="1,3" UIHint="Headline" Text="Beschreibung" />
                </ParameterBlock>
                <op:include href="Roborock.templ.xml" xpath="//Dynamic/ChannelIndependentBlock/ParameterBlock[@Name='Settings']/*" type="template" prefix="ROB" IsInner="true" />
              </ParameterBlock>

              <!-- Kanal-Tabs (nur aktivierte Kanäle) -->
              <op:include href="Roborock.templ.xml" xpath="//Dynamic/ChannelIndependentBlock/ParameterBlock[@Name='Channel']/*" type="template" prefix="ROB" IsInner="true" />
            </Channel>
          </Dynamic>
        </ApplicationProgram>
      </ApplicationPrograms>
      <Baggages>
        <Baggage TargetPath="" Name="Help_de.zip" Id="%FILE-HELP-de%">
          <FileInfo TimeInfo="%DATETIME%" />
        </Baggage>
      </Baggages>
    </Manufacturer>
  </ManufacturerData>
</KNX>
